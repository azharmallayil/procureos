# ==============================================================================
# ProcureOS - Client Environment Configuration (Browser-Safe)
# ==============================================================================
# IMPORTANT SECURITY DIRECTIVE:
# NEVER place SUPABASE_SERVICE_ROLE_KEY or any administrative secrets in this file
# or in any client-side environment file (e.g. .env, .env.local).
# Vite bundles all VITE_* variables directly into browser JavaScript chunks!
# Server-side administration must occur strictly via Postgres RLS or protected Edge Functions.
# ==============================================================================

# Supabase Project API URL (Public)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Client Key (Public JWT with RLS-enforced scope)
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Active Simulation Mode ('true' to use client-side mock data; 'false' to connect to live Supabase)
VITE_ENABLE_LIVE_BACKEND=false
